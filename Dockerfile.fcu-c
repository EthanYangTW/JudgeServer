# C-only classroom judge. The stock image installs Java, Go and Node runtimes.
# Build the pinned Judger submodule before using this Dockerfile.
FROM debian:trixie-slim AS builder
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake make gcc libc6-dev libseccomp-dev python3 python3-dev python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY Judger/ /app/
RUN cmake -S . -B build && cmake --build build --parallel 4
RUN cd bindings/Python && python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir build \
    && .venv/bin/python3 -m build -w
COPY server/unbuffer.c /app/unbuffer.c
RUN gcc -shared -fPIC -o /app/unbuffer.so /app/unbuffer.c

FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv gcc libc6-dev libseccomp2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/output/libjudger.so /usr/lib/judger/libjudger.so
COPY --from=builder /app/bindings/Python/dist/ /app/
RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir flask gunicorn idna psutil requests \
    && .venv/bin/pip install --no-cache-dir /app/*.whl
COPY server/ /app/
COPY --from=builder /app/unbuffer.so /app/unbuffer.so
RUN useradd -u 901 -r -s /usr/sbin/nologin -M compiler \
    && useradd -u 902 -r -s /usr/sbin/nologin -M code \
    && useradd -u 903 -r -s /usr/sbin/nologin -M -G code spj \
    && sed -i 's/\r$//' /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh \
    && chmod -R u=rwX,go=rX /app
HEALTHCHECK --interval=10s CMD ["/app/.venv/bin/python3", "/app/service.py"]
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
